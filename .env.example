# PLIA Local Environment Configuration
# Ollama local LLM endpoint (default: http://localhost:11434)
OLLAMA_BASE_URL="http://localhost:11434"

# Ollama preferred default generation model
OLLAMA_MODEL="llama3.2"

# Ollama preferred embedding model
OLLAMA_EMBED_MODEL="nomic-embed-text"

# Local Python FastAPI Backend Service URL (default: http://localhost:8000)
PLIA_BACKEND_URL="http://localhost:8000"

# Local SQLite Database file path
PLIA_DATABASE="plia.db"
